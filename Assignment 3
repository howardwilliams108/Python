# This Python code would obtain from the user a list of grades including:
# homework, quizzes, lab, and exam grades. Also, the code would calculate the final grade
# and averages.
def get_grades(category_name):
  '''Function to obtain grades from the user for the category.'''
  grades = []
  print(f'\nEnter {category_name} grades one by one. (Press ENTER with no input to stop.)')
  while True:
    grade = input('Enter grade (0-100): ')
    if grade == '':
      break
    if grade.isnumeric():
      grade = int(grade)
      if 0 <= grade <= 100:
        grades.append(grade)
      else:
        print('Invalid grade. Grade must be between 0 and 100.')
    else:
      print('Invalid grade. Grade must be a number.')
  return grades

#Category wrappers
def get_lab_grades():
  return get_grades('Lab')

def get_exam_grades():
  return get_grades('Exam')

def get_quiz_grades():
  return get_grades('Quiz')

def get_hw_grades():
  return get_grades('Homework')

def compute_average(grades):
  '''Return(sum, count average).'''
  if len(grades) == 0:
    return 0, 0, 0
  total = sum(grades)
  count = len(grades)
  average = total / count
  return total, count, average

def compute_grade(labs, exams, quizzes, hws, percentages):
  '''Compute weighted final grade.'''
  sums_counts_avgs = [
        compute_average(labs),
        compute_average(exams),
        compute_average(quizzes),
        compute_average(hws)
      ]
  weighted = [sums_counts_avgs[i][2] * percentages[i] for i in range (4)]
  final_grade = sum(weighted)

  return sums_counts_avgs, weighted, final_grade

def letter_grade(score):
  '''Convert numerical grade to letter grade.'''
  if score >= 90:
    return 'A'
  elif score >= 80:
    return 'B'
  elif score >= 70:
    return 'C'
  elif score >= 60:
    return 'D'
  else:
    return 'F'

def print_report(labs, exams, quizzes, hws, percentages, results, weighted, final_grade):
  categories = ['Labs', 'Exams', 'Quizzes', 'Homeworks']
  lists = [labs, exams, quizzes, hws]
  print('                      GRADE REPORT')
  print('#' * 60)

#Show results along with averages
  for i in range(4):
    total, count, average = results[i]
    print(f"{categories[i]} grades: {lists[i]} = {total} / {count} = {average:.1f}")

  print('\n' + '#' * 60)


# Display the weighted contributions
  for i in range(4):
    total, count, average = results[i]
    print(f"{categories[i]:<10}: {average:5.1f} x {percentages[i]:.2f} = {weighted[i]:5.1f}")

  print('\n' + '#' * 60)
  print(f"Total: {final_grade:.1f}")
  print(f"GRADE = {letter_grade(final_grade)}")
  print('#' * 60)

# *******************THE MAIN PROGRAM*************************************
def main():
  percentages = [0.1, 0.4, 0.1, 0.4]
  labs = get_lab_grades()
  exams = get_exam_grades()
  quizzes = get_quiz_grades()
  hws = get_hw_grades()
  results, weighted, final_grade = compute_grade(labs, exams, quizzes, hws, percentages)
  print_report(labs, exams, quizzes, hws, percentages, results, weighted, final_grade)

if __name__ == '__main__':
  main()
